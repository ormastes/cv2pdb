{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 15,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "ninja-multi-x64",
      "displayName": "Ninja Multi-Config x64",
      "description": "64-bit build with Ninja Multi-Config generator",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/x64",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo"
      }
    },
    {
      "name": "ninja-multi-x86",
      "displayName": "Ninja Multi-Config x86",
      "description": "32-bit build with Ninja Multi-Config generator",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/x86",
      "architecture": {
        "value": "x86",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64-debug",
      "configurePreset": "ninja-multi-x64",
      "configuration": "Debug"
    },
    {
      "name": "x64-release",
      "configurePreset": "ninja-multi-x64",
      "configuration": "Release"
    },
    {
      "name": "x86-debug",
      "configurePreset": "ninja-multi-x86",
      "configuration": "Debug"
    },
    {
      "name": "x86-release",
      "configurePreset": "ninja-multi-x86",
      "configuration": "Release"
    }
  ]
}
